PORT=3000
# New Deriv API OAuth app ID. Callback: https://tradebot-pro.onrender.com/auth/callback
DERIV_APP_ID=
# Execution is opt-in. Real accounts are always blocked.
DEMO_EXECUTION_ENABLED=false
# Render: use an actual persistent disk mount, for example /var/data/tradebot.
# VPS/local: use a protected persistent folder. Never commit its database.
TRADEBOT_DATA_DIR=
# Render only: HTTPS proxy to VPS. Leave empty on the VPS.
TRADEBOT_UPSTREAM_BASE=
# Shared server-to-server credential; never commit its actual value.
TRADEBOT_BRIDGE_KEY=
